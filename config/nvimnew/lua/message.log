+  vim.fn.mkdir(preview_dir, "p")
+
+  for i, entry in ipairs(entries) do
+    local preview_file = preview_dir .. "/error-" .. i .. ".txt"
+
+    vim.fn.writefile(
+      vim.split(entry.full_text or entry.summary or "", "\n", { plain = true }),
+      preview_file
+    )
+
+    entry.preview_file = preview_file
+  end
