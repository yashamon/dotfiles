+local function jump_to_error(entry)
+  if entry.filename and entry.filename ~= "" then
+    vim.cmd.edit(vim.fn.fnameescape(entry.filename))
+  elseif entry.bufnr and vim.api.nvim_buf_is_valid(entry.bufnr) then
